# AIShop — переменные окружения
# Скопируй в .env и заполни значения:
#   cp .env.example .env && nano .env

# ── Django ────────────────────────────────────────
# Генерация: python3 -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=ЗАМЕНИ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ_КЛЮЧ

DEBUG=False

ALLOWED_HOSTS=donor.asia,www.donor.asia,localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────
DB_NAME=aishop
DB_USER=aishop_user
DB_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── App settings ──────────────────────────────────
SITE_DOMAIN=donor.asia
SITE_URL=https://donor.asia
APP_PORT=8081

# ── AI (Gemini) ───────────────────────────────────
GEMINI_API_KEY=

# ── Email (Gmail SMTP) ────────────────────────────
EMAIL_HOST_USER=твой@gmail.com
EMAIL_HOST_PASSWORD=app-password-from-google
DEFAULT_FROM_EMAIL=AIShop <твой@gmail.com>
